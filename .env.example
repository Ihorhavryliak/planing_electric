# Copy this file to .env and adjust values for your environment.
NODE_ENV=development
API_PORT=5004
WEB_PORT=3004
WEB_ORIGIN=http://localhost:3004
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drawmyplace

# Authentication
SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MINUTES=15

# Plan file storage: "local" or "s3".
STORAGE_DRIVER=local
STORAGE_DIR=storage
MAX_UPLOAD_MB=20
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Comma-separated emails allowed to use /api/v1/admin endpoints.
PLATFORM_ADMIN_EMAILS=

# Email delivery. "log" prints messages to the API log; "smtp" sends them.
MAIL_DRIVER=log
MAIL_FROM=DrawMyPlace <no-reply@drawmyplace.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Short-lived export links.
EXPORT_LINK_SECRET=change-me-in-production
EXPORT_LINK_TTL_SECONDS=300

# Optional Redis for shared rate limiting across API instances.
REDIS_URL=
