{
  "name": "drawmyplace",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based electrical installation planning tool.",
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "browser:check": "node scripts/browser-check.mjs",
    "build": "turbo run build",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @drawmyplace/database db:generate",
    "db:migrate": "pnpm --filter @drawmyplace/database db:migrate",
    "db:seed:templates": "pnpm --filter @drawmyplace/contracts build && pnpm --filter @drawmyplace/database seed:templates",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "dev": "turbo run dev",
    "docker:prod:down": "docker compose -f infra/docker-compose.prod.yml down",
    "docker:prod:up": "docker compose -f infra/docker-compose.prod.yml up -d --build",
    "lint": "eslint .",
    "responsive:check": "node scripts/responsive-check.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "signaling:check": "node scripts/signaling-check.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
